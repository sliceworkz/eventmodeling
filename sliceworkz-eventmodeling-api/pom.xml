<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.sliceworkz</groupId>
		<artifactId>sliceworkz-eventmodeling-parent-pom</artifactId>
		<version>0.7.0-SNAPSHOT</version>
		<relativePath>../sliceworkz-eventmodeling-parent-pom</relativePath>
	</parent>

	<properties>
		<!-- client-facing: publish to the configured repository -->
		<maven.deploy.skip>false</maven.deploy.skip>
	</properties>
	<name>${project.artifactId}</name>
	<description>An opinionated Event Modeling framework in Java</description>
	<url>https://sliceworkz.github.io/eventmodeling</url>
	
	<artifactId>sliceworkz-eventmodeling-api</artifactId>
	<packaging>jar</packaging>
	
	<dependencies>
		<dependency>
			<groupId>org.sliceworkz</groupId>
			<artifactId>sliceworkz-eventstore-api</artifactId>
		</dependency>
		<!--
			BoundedContextEvent and ManagementInstruction carry Jackson annotations
			(@JsonIgnoreProperties, @JsonSetter) so that an event written by a newer release reads
			under an older one. Optional, as the eventstore api declares it: a JVM ignores an
			annotation whose type is absent at runtime, so a consumer that serializes nothing resolves
			nothing and loses nothing, and one that does already has it — this is the 2.x annotations
			artifact that Jackson 2 and Jackson 3 share (Jackson 3's databind depends on it). The
			eventstore api marks it optional too, so it no longer arrives transitively from there.
		-->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
			<optional>true</optional>
		</dependency>
		<!--
			Test scope only. SqlReadModelProjector writes SQL that has to survive a real database:
			its bookmark upsert and its idempotent-write helpers were previously asserted against a
			mock Connection, which cannot tell whether the statements parse, let alone whether the
			freshness comparison selects the right rows.
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	
	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
